# ─────────────────────────────────────────────────────────────
# ATS Resume Tailor — environment
# Copy to .env.local (gitignored) and fill in.
# ─────────────────────────────────────────────────────────────

# --- LLM provider -------------------------------------------
# Which engine runs the five prompts. Pick ONE preset below.
#
# There is no such thing as an unlimited free hosted LLM API. Every free tier
# meters you somehow. The only genuinely unlimited option is running the model
# yourself (preset D) — which is also the only one where your resume never
# leaves the machine.
#
# Verified against live accounts in Aug 2026. These change; re-check before
# trusting a comparison article.

LLM_PROVIDER=groq

# ─ Preset A — Groq. Free, no card. 8k tokens/min, which is tight: a full run
#   exceeds it, so the app pauses mid-flow and resumes by itself. Groq's
#   services agreement forbids training on your inputs. This is the default.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_MODEL=openai/gpt-oss-120b
# Per-minute token budget of your tier. The adapter sizes each request to fit,
# because metered tiers charge prompt + reserved completion, used or not.
OPENAI_COMPATIBLE_TPM=8000
#
# ─ Preset B — Ollama, on your own machine. Genuinely unlimited: no key, no
#   quota, no rate limit, and nothing leaves your computer. Needs ~8GB RAM for
#   a 7-8B model. The adapter detects a localhost URL and skips key checks and
#   token budgeting entirely. Weaker writing than the hosted 120B — the right
#   trade if the resume is genuinely sensitive.
#     winget install Ollama.Ollama
#     ollama pull qwen2.5:7b-instruct
#     LLM_PROVIDER=groq
#     OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#     OPENAI_COMPATIBLE_MODEL=qwen2.5:7b-instruct
#     (leave OPENAI_COMPATIBLE_API_KEY blank)
#
# ─ Preset C — Google AI Studio. Free with very high limits, BUT the free tier
#   explicitly allows human review of your prompts and training on them. Not
#   recommended for real resume data. Set LLM_PROVIDER=gemini to use it.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# ─ Preset D — Cerebras. NOT free despite what comparison articles say. A new
#   account in Aug 2026 gets pay-as-you-go with a $0.00 balance and the API
#   returns 402 payment_required until funded. Once funded it is excellent —
#   90k tokens/min, same gpt-oss-120b, no training on your inputs — and the
#   app stops pausing entirely.
#     LLM_PROVIDER=groq
#     OPENAI_COMPATIBLE_API_KEY=csk-...
#     OPENAI_COMPATIBLE_BASE_URL=https://api.cerebras.ai/v1
#     OPENAI_COMPATIBLE_MODEL=gpt-oss-120b
#     OPENAI_COMPATIBLE_TPM=90000
#
# Safety catch: a metered provider refuses to start unless this is true.
# Everything above except Anthropic runs free, so paying should be deliberate.
ALLOW_PAID_PROVIDERS=false
#
# ─ Preset E — Anthropic. What the original spec locked in. Paid credits, a few
#   cents per resume, does not train on inputs. Set LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Auth ---------------------------------------------------
# Generate with:  npx auth secret     (or)  openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional: "Continue with Google". Leave blank to hide the button and use
# email + password only. Free to create at https://console.cloud.google.com
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database -----------------------------------------------
DATABASE_URL="file:./dev.db"

# --- Limits -------------------------------------------------
MAX_UPLOAD_MB=5
RATE_LIMIT_GENERATIONS_PER_HOUR=20
