# ─────────────────────────────────────────────────────────────
# ATS Resume Tailor — environment
# Copy to .env.local (gitignored) and fill in.
# ─────────────────────────────────────────────────────────────

# --- LLM provider -------------------------------------------
# Which engine runs the five prompts. Pick ONE preset below.
#
# There is no such thing as an unlimited free hosted LLM API. Every free tier
# meters you somehow. The only genuinely unlimited option is running the model
# yourself (preset D) — which is also the only one where your resume never
# leaves the machine.
#
# Verified against live accounts in Aug 2026. These change; re-check before
# trusting a comparison article.

LLM_PROVIDER=groq

# ─ Preset A — Groq. Free, no card. 8k tokens/min, which is tight: a full run
#   exceeds it, so the app pauses mid-flow and resumes by itself. Groq's
#   services agreement forbids training on your inputs. This is the default.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_MODEL=openai/gpt-oss-120b
# Per-minute token budget of your tier. The adapter sizes each request to fit,
# because metered tiers charge prompt + reserved completion, used or not.
OPENAI_COMPATIBLE_TPM=8000
#
# ─ Preset B — Ollama, on your own machine. Genuinely unlimited: no key, no
#   quota, no rate limit, and nothing leaves your computer. Needs ~8GB RAM for
#   a 7-8B model. The adapter detects a localhost URL and skips key checks and
#   token budgeting entirely. Weaker writing than the hosted 120B — the right
#   trade if the resume is genuinely sensitive.
#     winget install Ollama.Ollama
#     ollama pull qwen2.5:7b-instruct
#     LLM_PROVIDER=groq
#     OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#     OPENAI_COMPATIBLE_MODEL=qwen2.5:7b-instruct
#     (leave OPENAI_COMPATIBLE_API_KEY blank)
#
# ─ Preset C — Google AI Studio. Free with very high limits, BUT the free tier
#   explicitly allows human review of your prompts and training on them. Not
#   recommended for real resume data. Set LLM_PROVIDER=gemini to use it.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# ─ Preset D — Cerebras. NOT free despite what comparison articles say. A new
#   account in Aug 2026 gets pay-as-you-go with a $0.00 balance and the API
#   returns 402 payment_required until funded. Once funded it is excellent —
#   90k tokens/min, same gpt-oss-120b, no training on your inputs — and the
#   app stops pausing entirely.
#     LLM_PROVIDER=groq
#     OPENAI_COMPATIBLE_API_KEY=csk-...
#     OPENAI_COMPATIBLE_BASE_URL=https://api.cerebras.ai/v1
#     OPENAI_COMPATIBLE_MODEL=gpt-oss-120b
#     OPENAI_COMPATIBLE_TPM=90000
#
# Safety catch: a metered provider refuses to start unless this is true.
# Everything above except Anthropic runs free, so paying should be deliberate.
ALLOW_PAID_PROVIDERS=false
#
# ─ Preset E — Anthropic. What the original spec locked in. Paid credits, a few
#   cents per resume, does not train on inputs. Set LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Spare endpoints (optional) ------------------------------
# What keeps this running when a free tier changes its mind.
#
# A free tier is not a promise anyone made you. Keys get revoked, limits get
# tightened, accounts get suspended, hosts go down. None of that can be
# prevented from here — but it can be made survivable. List one or more spares
# and a call that fails on the primary is retried on the next one, in order,
# before the user ever sees an error.
#
# Each name in LLM_FALLBACKS gets its own variables, prefixed LLM_<NAME>_
# (uppercased, non-letters become underscores). Anything not set falls back to
# the primary's value, so a spare on the same account is two lines.
#
# Nothing is charged for silently: a spare on a metered provider is refused and
# reported at startup unless ALLOW_PAID_PROVIDERS=true, exactly like a primary.
#
# Leave blank and behaviour is identical to having no chain at all.
LLM_FALLBACKS=
#
# ─ Example 1 — a local model as the last resort. The only endpoint that
#   cannot be taken away from you, because it is yours. Useless on a deployed
#   instance (localhost is the server, not your machine), ideal locally.
#     winget install Ollama.Ollama
#     ollama pull qwen2.5:3b
#     LLM_FALLBACKS=ollama
#     LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
#     LLM_OLLAMA_MODEL=qwen2.5:3b
#
#   Size it to your VRAM, not your ambition. A 7B at Q4 is ~4.7GB and will not
#   fit a 4GB card; what it does instead is spill into system RAM and crawl,
#   which reads as the app hanging. A 3B at ~1.9GB fits and answers in ~25s.
#
#   Be clear-eyed about what a small local model buys. It keeps the app
#   *working* when every hosted tier is gone. It does not match them: qwen2.5:3b
#   cites the employer's header line as evidence for most bullets, which the
#   relatedness check in lib/validate/evidence.ts rejects — so the resume you
#   get is thinner, not fabricated. That is the guard doing its job, and it is
#   the right trade for a last resort. Prefer a second hosted account above it
#   in the chain, and keep this one at the end.
#
#   Tested on this machine (GTX 1650, 4GB VRAM): qwen2.5:3b handled all three
#   prompts at ~25s each. llama3.2:3b extracted less than half the keywords and
#   stalled past the 60s per-call timeout. Re-measure before switching.
#
# ─ Example 2 — a smaller model on the same account. Costs nothing to add and
#   covers the common case where the big model is busy or the request is too
#   large for the per-minute budget. Inherits the primary's key.
#     LLM_FALLBACKS=smaller
#     LLM_SMALLER_MODEL=llama-3.1-8b-instant
#
# ─ Example 3 — a second provider entirely, which is what actually survives an
#   account being closed. Any OpenAI-compatible endpoint works.
#     LLM_FALLBACKS=other
#     LLM_OTHER_BASE_URL=https://api.example.com/v1
#     LLM_OTHER_API_KEY=...
#     LLM_OTHER_MODEL=...
#     LLM_OTHER_TPM=8000
#
# ─ Chained, in preference order:
#     LLM_FALLBACKS=smaller,other,ollama
#
# `npm run llm:check` prints the resolved chain, including any spare that was
# skipped and why — check it after editing, because a spare you believe you
# have and do not is worse than no spare at all.

# --- Auth ---------------------------------------------------
# Generate with:  npx auth secret     (or)  openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional: "Continue with Google". Leave blank to hide the button and use
# email + password only. Free to create at https://console.cloud.google.com
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database -----------------------------------------------
DATABASE_URL="file:./dev.db"

# --- Export ---------------------------------------------------
# Spacing in the exported documents adapts to their length: comfortable when
# the content fits, compressed only when a few stray lines would otherwise
# spill onto a near-empty page. Set this to force a fixed scale instead —
# 1 is fully comfortable, 0.68 is the compressed setting.
# EXPORT_DENSITY_SCALE=

# --- Access ---------------------------------------------------
# Set this on any instance reachable by other people. Signing up then requires
# the code, because every account shares this instance's API key, its rate
# limit, and its database. Leave blank locally.
SIGNUP_CODE=

# --- Limits -------------------------------------------------
MAX_UPLOAD_MB=5
RATE_LIMIT_GENERATIONS_PER_HOUR=20
