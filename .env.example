# ─────────────────────────────────────────────────────────────
# ATS Resume Tailor — environment
# Copy to .env.local (gitignored) and fill in.
# ─────────────────────────────────────────────────────────────

# --- LLM provider -------------------------------------------
# Which engine runs the five prompts. Pick ONE preset below.
#
# There is no such thing as an unlimited free hosted LLM API. Every free tier
# meters you somehow. The only genuinely unlimited option is running the model
# yourself (preset D) — which is also the only one where your resume never
# leaves the machine.
#
# Free-tier limits move around; the numbers below were checked in Aug 2026.

LLM_PROVIDER=groq

# ─ Preset A — Cerebras. The most generous free tier, and the recommended one.
#   ~60k tokens/min and ~1M tokens/day, roughly 8x Groq's throughput, so the
#   app stops pausing mid-run. Terms state Cerebras is not granted the right to
#   train or fine-tune on your content.
#   Free key (no card): https://cloud.cerebras.ai
#     LLM_PROVIDER=groq
#     OPENAI_COMPATIBLE_API_KEY=csk-...
#     OPENAI_COMPATIBLE_BASE_URL=https://api.cerebras.ai/v1
#     OPENAI_COMPATIBLE_MODEL=llama-3.3-70b
#     OPENAI_COMPATIBLE_TPM=60000
#
# ─ Preset B — Groq. Fast, but only 8k tokens/min free, which is why a full
#   run pauses partway. Also forbids training on your inputs.
#   Free key: https://console.groq.com/keys
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_MODEL=openai/gpt-oss-120b
# Per-minute token budget of your tier. The adapter sizes each request to fit,
# because metered tiers charge prompt + reserved completion, used or not.
OPENAI_COMPATIBLE_TPM=8000
#
# ─ Preset C — Google AI Studio. Very high free limits, but the free tier
#   explicitly allows human review of prompts and training on them. Not
#   recommended for real resume data. Set LLM_PROVIDER=gemini to use it.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# ─ Preset D — Ollama, on your own machine. Genuinely unlimited: no key, no
#   quota, no rate limit, and nothing leaves your computer. Needs ~8GB RAM for
#   a 7-8B model. The adapter detects a localhost URL and skips key checks and
#   token budgeting entirely.
#     winget install Ollama.Ollama
#     ollama pull qwen2.5:7b-instruct
#     LLM_PROVIDER=groq
#     OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#     OPENAI_COMPATIBLE_MODEL=qwen2.5:7b-instruct
#     (leave OPENAI_COMPATIBLE_API_KEY blank)
#
# ─ Preset E — Anthropic. What the original spec locked in. Paid credits, a few
#   cents per resume, does not train on inputs. Set LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Auth ---------------------------------------------------
# Generate with:  npx auth secret     (or)  openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional: "Continue with Google". Leave blank to hide the button and use
# email + password only. Free to create at https://console.cloud.google.com
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database -----------------------------------------------
DATABASE_URL="file:./dev.db"

# --- Limits -------------------------------------------------
MAX_UPLOAD_MB=5
RATE_LIMIT_GENERATIONS_PER_HOUR=20
