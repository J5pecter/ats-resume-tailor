{
  "name": "Resume Tailor (Python)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "postCreateCommand": "pip install -e ./pytailor -e './webapp[dev,postgres]'",

  "postStartCommand": "bash .devcontainer/start.sh",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Resume Tailor",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["webapp/tests", "pytailor/tests"]
      }
    }
  },

  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
