# Copy to .env. Every line is optional — the app runs with none of them, using
# SQLite and printing sign-in codes to the terminal.

# Signs the session cookie. Required on a managed host; the app refuses to
# start without one there, because the alternatives are forgeable sessions or
# everyone logged out on every deploy.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Postgres when set, SQLite when not. postgres:// is rewritten automatically.
DATABASE_URL=

# A free key from https://console.groq.com/keys.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=openai/gpt-oss-120b

# A spare endpoint, tried when the primary is rate-limited or the request is
# too large for its per-minute budget. Inherits the key above.
LLM_FALLBACKS=smaller
LLM_SMALLER_MODEL=openai/gpt-oss-20b

# Mail for the one-time codes. Anything that speaks SMTP: a Gmail app password,
# Resend, Mailtrap. Without these the codes print to the server log — right on
# a laptop, useless in production, and it says so every time.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: a Google Apps Script web app URL that appends a row per sign-up and
# sign-in. Never receives passwords — they are hashes, so there are none to send.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
